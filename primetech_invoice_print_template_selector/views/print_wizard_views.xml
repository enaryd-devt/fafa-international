<?xml version="1.0" encoding="UTF-8"?>

<odoo>


    <record id="view_print_wizard_form" model="ir.ui.view">
        <field name="name">primetech.invoice.print.wizard.form</field>
        <field name="model">primetech.invoice.print.wizard</field>
        <field name="arch" type="xml">

            <form string="Impression de facture">

                <sheet>

                    <div class="oe_title">
                        <h1>Options d'impression</h1>
                    </div>

                    <group>

                        <group string="Garantie">

                            <field name="warranty_period"
                                widget="radio"/>

                        </group>

                        <group string="Documents complémentaires">

                            <field name="print_agreement_protocol"/>

                        </group>

                    </group>

                    <separator string="Informations"/>

                    <div class="alert alert-info">
                        Sélectionnez la durée de garantie à afficher sur la facture.
                        <br/>
                        Le protocole d'accord SAV peut être ajouté automatiquement à la suite de la facture.
                    </div>

                </sheet>

                <footer>

                    <button name="action_print"
                            type="object"
                            string="Imprimer"
                            class="btn-primary"/>

                    <button string="Annuler"
                            special="cancel"/>

                </footer>

            </form>

        </field>
    </record>

    <record id="action_print_invoice_wizard"
            model="ir.actions.act_window">

        <field name="name">Impression facture</field>

        <field name="res_model">primetech.invoice.print.wizard</field>

        <field name="view_mode">form</field>

        <field name="target">new</field>

    </record>


</odoo>
