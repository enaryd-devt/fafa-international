<?xml version="1.0" encoding="UTF-8"?>

<odoo>


    <template id="main_report">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">

                <!-- FACTURE -->

                <t t-call="primetech_invoice_print_template_selector.template_invoice"/>

                <!-- PROTOCOLE D'ACCORD -->

                <t t-if="env.context.get('print_agreement_protocol')">

                    <div style="page-break-before: always;"/>

                    <t t-call="primetech_invoice_print_template_selector.protocol_agreement_template"/>

                </t>

            </t>

        </t>

    </template>

</odoo>
