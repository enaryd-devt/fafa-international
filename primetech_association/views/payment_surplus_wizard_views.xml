<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record
        id="view_association_payment_surplus_wizard_form"
        model="ir.ui.view">

        <field name="name">association.payment.surplus.wizard.form</field>

        <field name="model">association.payment.surplus.wizard</field>

        <field name="arch" type="xml">

            <form string="Gestion du surplus">

                <sheet>

                    <div class="oe_title">

                        <h1>
                            Gestion du surplus
                        </h1>

                        <p class="text-muted">
                            Le montant reçu dépasse le montant
                            restant à payer.
                        </p>

                    </div>

                    <group>

                        <group string="Membre">

                            <field name="member_id"/>

                            <field
                                name="payment_id"
                                invisible="1"/>

                        </group>

                        <group string="Montants">

                            <field name="currency_id" invisible="1"/>

                            <field name="received_amount"/>

                            <field name="allocated_amount"/>

                            <field name="surplus_amount"/>

                        </group>

                    </group>

                    <separator
                        string="Traitement du surplus"/>

                    <group>

                        <field
                            name="surplus_action"
                            widget="radio"/>

                    </group>

                    <group>

                        <field
                            name="note"
                            placeholder="Observation sur le traitement du surplus..."/>

                    </group>

                </sheet>

                <footer>

                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirmer"
                        class="btn-primary"/>

                    <button
                        string="Annuler"
                        special="cancel"
                        class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>