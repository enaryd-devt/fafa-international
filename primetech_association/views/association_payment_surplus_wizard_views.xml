<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ========================================================= -->
    <!-- WIZARD - GESTION DU SURPLUS DE PAIEMENT                  -->
    <!-- ========================================================= -->

    <record
        id="view_association_payment_surplus_wizard_form"
        model="ir.ui.view">

        <field name="name">association.payment.surplus.wizard.form</field>

        <field name="model">association.payment.surplus.wizard</field>

        <field name="arch" type="xml">

            <form string="Traitement du surplus">

                <sheet>

                    <!-- ========================================= -->
                    <!-- TITRE                                     -->
                    <!-- ========================================= -->

                    <div class="oe_title">

                        <h1>
                            Traitement du surplus
                        </h1>

                        <p class="text-muted">
                            Le montant reçu dépasse le montant
                            réellement affectable à la cotisation.
                        </p>

                    </div>

                    <!-- ========================================= -->
                    <!-- INFORMATIONS                              -->
                    <!-- ========================================= -->

                    <group>

                        <group string="Paiement">

                            <field
                                name="payment_id"
                                readonly="1"/>

                            <field
                                name="member_id"
                                readonly="1"/>

                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                readonly="1"/>

                        </group>

                        <group string="Montants">

                            <field
                                name="currency_id"
                                invisible="1"/>

                            <field
                                name="received_amount"
                                string="Montant reçu"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                                readonly="1"/>

                            <field
                                name="allocated_amount"
                                string="Affecté à la cotisation"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                                readonly="1"/>

                            <field
                                name="surplus_amount"
                                string="Surplus"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                                readonly="1"/>

                        </group>

                    </group>

                    <!-- ========================================= -->
                    <!-- TRAITEMENT DU SURPLUS                     -->
                    <!-- ========================================= -->

                    <separator
                        string="Que souhaitez-vous faire du surplus ?"/>

                    <group>

                        <field
                            name="surplus_action"
                            widget="radio"/>

                    </group>

                    <!-- ========================================= -->
                    <!-- OBSERVATION                               -->
                    <!-- ========================================= -->

                    <group string="Observation">

                        <field
                            name="note"
                            nolabel="1"
                            placeholder="Observation sur le traitement du surplus..."/>

                    </group>

                </sheet>

                <!-- ============================================= -->
                <!-- ACTIONS                                       -->
                <!-- ============================================= -->

                <footer>

                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirmer le traitement"
                        class="btn-primary"/>

                    <button
                        string="Annuler"
                        special="cancel"
                        class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>