<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- VUE RECHERCHE                                             -->
    <!-- ========================================================= -->

    <record id="view_subscription_search" model="ir.ui.view">
        <field name="name">association.subscription.search</field>
        <field name="model">association.subscription</field>
        <field name="arch" type="xml">

            <search string="Rechercher une cotisation">

                <field name="name"/>
                <field name="code"/>
                <field name="subscription_type"/>
                <field name="date"/>
                <field name="due_date"/>

                <separator/>

                <filter
                    name="filter_draft"
                    string="Brouillons"
                    domain="[('state', '=', 'draft')]"/>

                <filter
                    name="filter_confirmed"
                    string="Confirmées"
                    domain="[('state', '=', 'confirmed')]"/>

                <filter
                    name="filter_running"
                    string="En cours"
                    domain="[('state', '=', 'running')]"/>

                <filter
                    name="filter_closed"
                    string="Clôturées"
                    domain="[('state', '=', 'closed')]"/>

                <filter
                    name="filter_cancelled"
                    string="Annulées"
                    domain="[('state', '=', 'cancelled')]"/>

                <separator/>

                <filter
                    name="filter_overdue"
                    string="Échéance dépassée"
                    domain="[
                        ('due_date', '&lt;', context_today()),
                        ('state', '=', 'running')
                    ]"/>

                <separator/>

                <filter
                    name="filter_monthly"
                    string="Mensuelles"
                    domain="[('subscription_type', '=', 'monthly')]"/>

                <filter
                    name="filter_annual"
                    string="Annuelles"
                    domain="[('subscription_type', '=', 'annual')]"/>

                <group expand="0" string="Regrouper par">

                    <filter
                        name="group_subscription_type"
                        string="Type"
                        context="{'group_by': 'subscription_type'}"/>

                    <filter
                        name="group_state"
                        string="Statut"
                        context="{'group_by': 'state'}"/>

                    <filter
                        name="group_date"
                        string="Date"
                        context="{'group_by': 'date:month'}"/>

                    <filter
                        name="group_company"
                        string="Société"
                        context="{'group_by': 'company_id'}"/>

                </group>

            </search>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- VUE LISTE                                                 -->
    <!-- ========================================================= -->

    <record id="view_subscription_list" model="ir.ui.view">
        <field name="name">association.subscription.list</field>
        <field name="model">association.subscription</field>
        <field name="arch" type="xml">

            <list
                string="Cotisations"
                decoration-info="state == 'draft'"
                decoration-primary="state == 'confirmed'"
                decoration-warning="state == 'running'"
                decoration-success="state == 'closed'"
                decoration-muted="state == 'cancelled'">

                <field name="code"/>

                <field name="name"/>

                <field
                    name="subscription_type"
                    widget="badge"/>

                <field name="date"/>

                <field name="due_date"/>

                <field
                    name="line_count"
                    string="Membres"/>

                <field
                    name="total_amount_due"
                    sum="Total attendu"/>

                <field
                    name="total_amount_paid"
                    sum="Total payé"/>

                <field
                    name="total_balance"
                    sum="Reste total"/>

                <field
                    name="progress_percent"
                    widget="progressbar"
                    string="Recouvrement"/>

                <field
                    name="state"
                    widget="badge"/>

                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="hide"/>

            </list>

        </field>
    </record>

    <!-- ========================================================= -->
    <!-- VUE FORMULAIRE                                            -->
    <!-- ========================================================= -->

    <record id="view_subscription_form" model="ir.ui.view">

        <field name="name">association.subscription.form</field>

        <field name="model">association.subscription</field>

        <field name="arch" type="xml">

            <form string="Cotisation">

                <!-- ================================================= -->
                <!-- HEADER                                            -->
                <!-- ================================================= -->

                <header>

                    <button
                        name="action_generate_members"
                        string="Générer les membres"
                        type="object"
                        class="btn-secondary"
                        icon="fa-users"
                        invisible="state != 'draft'"/>

                    <button
                        name="action_confirm"
                        string="Confirmer"
                        type="object"
                        class="btn-primary"
                        icon="fa-check"
                        invisible="state != 'draft'"/>

                    <button
                        name="action_start"
                        string="Démarrer"
                        type="object"
                        class="btn-primary"
                        icon="fa-play"
                        invisible="state != 'confirmed'"/>

                    <button
                        name="action_close"
                        string="Clôturer"
                        type="object"
                        class="btn-primary"
                        icon="fa-lock"
                        invisible="state != 'running'"/>

                        <button
                            name="action_close_current_period"
                            string="Terminer le cycle"
                            type="object"
                            class="btn-secondary"
                            icon="fa-check-circle"
                            groups="primetech_association.group_association_manager,primetech_association.group_association_admin"
                            invisible="state != 'running' or not current_period_id"
                            confirm="Voulez-vous lancer la procédure de clôture du cycle courant ?"
                        />

                        <button
                            name="action_open_next_period"
                            string="Cycle suivant"
                            type="object"
                            class="btn-primary"
                            icon="fa-forward"
                            groups="primetech_association.group_association_manager,primetech_association.group_association_admin"
                            invisible="state != 'running' or current_period_id"
                            confirm="Voulez-vous ouvrir le cycle suivant ?"
                        />

                    <button
                        name="action_cancel"
                        string="Annuler"
                        type="object"
                        class="btn-secondary"
                        icon="fa-times"
                        invisible="state in ('closed', 'cancelled')"/>

                    <button
                        name="action_reset_draft"
                        string="Remettre en brouillon"
                        type="object"
                        class="btn-secondary"
                        icon="fa-undo"
                        invisible="state not in ('confirmed', 'cancelled')"/>

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,running,closed"/>

                </header>

                <!-- ================================================= -->
                <!-- SHEET                                             -->
                <!-- ================================================= -->

                <sheet>

                    <!-- ================================================= -->
                    <!-- SMART BUTTONS                                     -->
                    <!-- ================================================= -->

                    <div
                        class="oe_button_box"
                        name="button_box"
                    >

                        <button
                            class="oe_stat_button"
                            icon="fa-users"
                            type="object"
                            name="action_generate_members"
                            invisible="state != 'draft'"
                        >

                            <field
                                name="line_count"
                                widget="statinfo"
                                string="Membres"
                            />

                        </button>

                    </div>

                    <div class="oe_button_box" name="button_box">

                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_view_payments"
                            icon="fa-money">

                            <field
                                name="payment_count"
                                widget="statinfo"
                                string="Paiements"/>

                        </button>

                    </div>

                    <!-- ================================================= -->
                    <!-- TITRE                                             -->
                    <!-- ================================================= -->

                    <div class="oe_title">

                        <label
                            for="name"
                            class="o_form_label"
                        />

                        <h1>

                            <field
                                name="name"
                                placeholder="Ex. Cotisation mensuelle - Janvier 2026"
                            />

                        </h1>

                        <div
                            class="d-flex align-items-center gap-2 flex-wrap mt-2"
                        >

                            <div
                                class="d-inline-flex align-items-center rounded-pill text-bg-light border px-2 py-1"
                                style="white-space: nowrap;"
                            >

                                <i
                                    class="fa fa-hashtag me-1"
                                    title="Référence"
                                />

                                <field
                                    name="code"
                                    readonly="1"
                                    nolabel="1"
                                    class="oe_inline"
                                />

                            </div>

                            <field
                                name="subscription_type"
                                widget="badge"
                                readonly="state != 'draft'"
                            />

                        </div>

                    </div>

                    <!-- ================================================= -->
                    <!-- KPI                                               -->
                    <!-- ================================================= -->

                    <div class="row mt-4 mb-4">

                        <!-- MONTANT ATTENDU -->

                        <div class="col-lg-3 col-md-6 mb-3">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small">

                                    <i
                                        class="fa fa-money me-1"
                                        title="Montant attendu"
                                    />

                                    Montant attendu

                                </div>

                                <div class="fs-4 fw-bold mt-2">

                                    <field
                                        name="total_amount_due"
                                        widget="monetary"
                                        options="{'currency_field': 'currency_id'}"
                                    />

                                </div>

                            </div>

                        </div>

                        <!-- MONTANT PAYÉ -->

                        <div class="col-lg-3 col-md-6 mb-3">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small">

                                    <i
                                        class="fa fa-check-circle me-1"
                                        title="Montant payé"
                                    />

                                    Montant payé

                                </div>

                                <div class="fs-4 fw-bold mt-2">

                                    <field
                                        name="total_amount_paid"
                                        widget="monetary"
                                        options="{'currency_field': 'currency_id'}"
                                    />

                                </div>

                            </div>

                        </div>

                        <!-- RESTE À PAYER -->

                        <div class="col-lg-3 col-md-6 mb-3">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small">

                                    <i
                                        class="fa fa-hourglass-half me-1"
                                        title="Reste à payer"
                                    />

                                    Reste à payer

                                </div>

                                <div class="fs-4 fw-bold mt-2">

                                    <field
                                        name="total_balance"
                                        widget="monetary"
                                        options="{'currency_field': 'currency_id'}"
                                    />

                                </div>

                            </div>

                        </div>

                        <!-- TAUX DE RECOUVREMENT -->

                        <div class="col-lg-3 col-md-6 mb-3">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small">

                                    <i
                                        class="fa fa-line-chart me-1"
                                        title="Taux de recouvrement"
                                    />

                                    Taux de recouvrement

                                </div>

                                <div class="mt-3">

                                    <field
                                        name="progress_percent"
                                        widget="progressbar"
                                    />

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- ================================================= -->
                    <!-- INFORMATIONS                                      -->
                    <!-- ================================================= -->

                    <group>

                        <!-- ================================================= -->
                        <!-- PARAMÈTRES DE LA COTISATION                       -->
                        <!-- ================================================= -->

                        <group string="Paramètres de la cotisation">

                            <field
                                name="subscription_type"
                                readonly="state != 'draft'"
                            />

                            <field
                                name="amount"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                                readonly="state != 'draft'"
                            />

                            <field
                                name="company_id"
                                string="Filiale"
                                groups="base.group_multi_company"
                                readonly="state != 'draft'"
                            />

                        </group>

                        <!-- ================================================= -->
                        <!-- PÉRIODE                                           -->
                        <!-- ================================================= -->

                        <group string="Période de cotisation">

                            <field
                                name="date"
                                readonly="state != 'draft'"
                            />

                            <field
                                name="due_date"
                                readonly="state != 'draft'"
                            />

                            <field
                                name="period_start_date"
                                readonly="state != 'draft'"
                            />

                            <field
                                name="period_end_date"
                                readonly="state != 'draft'"
                            />

                        </group>

                    </group>

                    <!-- ================================================= -->
                    <!-- INFORMATIONS DE SUIVI                             -->
                    <!-- ================================================= -->

                    <group>

                        <group string="Suivi des membres">

                            <field
                                name="line_count"
                                readonly="1"
                            />

                            <field
                                name="paid_member_count"
                                readonly="1"
                            />

                        </group>

                        <group string="Situation des paiements">

                            <field
                                name="partial_member_count"
                                readonly="1"
                            />

                            <field
                                name="unpaid_member_count"
                                readonly="1"
                            />

                        </group>

                    </group>

                    <!-- ================================================= -->
                    <!-- DESCRIPTION                                       -->
                    <!-- ================================================= -->

                    <group string="Description">

                        <field
                            name="description"
                            nolabel="1"
                            placeholder="Description ou objet de la cotisation..."
                        />

                    </group>

                    <!-- ================================================= -->
                    <!-- NOTEBOOK                                          -->
                    <!-- ================================================= -->

                    <notebook>

                        <!-- ================================================= -->
                        <!-- MEMBRES                                           -->
                        <!-- ================================================= -->

                        <page
                            string="Membres"
                            name="subscription_members">

                            <field
                                name="line_ids"
                                readonly="state in ('closed', 'cancelled')">

                                <list
                                    editable="bottom"
                                    decoration-success="payment_state == 'paid'"
                                    decoration-warning="payment_state == 'partial'"
                                    decoration-danger="payment_state == 'not_paid'">

                                    <field
                                        name="sequence"
                                        widget="handle"/>

                                    <field
                                        name="image_128"
                                        widget="image"
                                        options="{'size': [40, 40]}"
                                        width="50"/>

                                    <field
                                        name="member_code"
                                        string="Code"/>

                                    <field
                                        name="member_id"
                                        string="Membre"/>

                                    <field
                                        name="category_id"
                                        string="Catégorie"
                                        optional="show"/>

                                    <field
                                        name="function_id"
                                        string="Fonction"
                                        optional="show"/>

                                    <field
                                        name="phone"
                                        string="Téléphone"
                                        optional="hide"/>

                                    <field
                                        name="amount_due"
                                        string="Montant dû"
                                        readonly="1"
                                        sum="Total dû"/>

                                    <field
                                        name="amount_paid"
                                        string="Montant payé"
                                        readonly="1"
                                        sum="Total payé"/>

                                    <field
                                        name="balance"
                                        string="Reste"
                                        readonly="1"
                                        sum="Reste total"/>

                                    <!-- ============================================= -->
                                    <!-- SAISIE DIRECTE DU MONTANT REÇU                -->
                                    <!-- ============================================= -->

                                    <field
                                        name="amount_received"
                                        string="Montant reçu"
                                        widget="monetary"
                                        options="{'currency_field': 'currency_id'}"
                                        readonly="payment_state == 'paid'"/>

                                    <field
                                        name="payment_state"
                                        string="État"
                                        widget="badge"
                                        readonly="1"
                                        decoration-danger="payment_state == 'not_paid'"
                                        decoration-warning="payment_state == 'partial'"
                                        decoration-success="payment_state == 'paid'"/>

                                    <field
                                        name="payment_date"
                                        string="Dernier paiement"
                                        readonly="1"
                                        optional="show"/>

                                    <!-- ============================================= -->
                                    <!-- PAYER LE MONTANT SAISI                        -->
                                    <!-- ============================================= -->

                                    <button
                                        name="action_create_payment"
                                        type="object"
                                        string="Payer"
                                        icon="fa-money"
                                        class="btn-primary"
                                        invisible="
                                            amount_received &lt;= 0
                                            or payment_state == 'paid'
                                            or balance &lt;= 0
                                        "/>

                                    <!-- ============================================= -->
                                    <!-- PAYER AVEC LE COMPTE MEMBRE                   -->
                                    <!-- ============================================= -->

                                    <button
                                        name="action_pay_from_member_account"
                                        type="object"
                                        string="Compte"
                                        icon="fa-university"
                                        class="btn-secondary"
                                        invisible="
                                            amount_received &gt; 0
                                            or payment_state == 'paid'
                                            or balance &lt;= 0
                                        "/>

                                    <field
                                        name="currency_id"
                                        column_invisible="1"/>

                                </list>

                            </field>

                        </page>

                        <!-- ================================================= -->
                        <!-- ANALYSE                                           -->
                        <!-- ================================================= -->

                        <page
                            string="Analyse"
                            name="subscription_analysis"
                            >

                            <div class="row mt-3">

                                <!-- MEMBRES À JOUR -->

                                <div class="col-lg-4 col-md-6 mb-3">

                                    <div
                                        class="border rounded p-4 text-center h-100"
                                    >

                                        <i
                                            class="fa fa-check-circle fa-2x mb-2"
                                            title="Membres à jour"
                                        />

                                        <div class="fs-2 fw-bold">

                                            <field
                                                name="paid_member_count"
                                            />

                                        </div>

                                        <div class="text-muted">

                                            Membres à jour

                                        </div>

                                    </div>

                                </div>

                                <!-- PAIEMENTS PARTIELS -->

                                <div class="col-lg-4 col-md-6 mb-3">

                                    <div
                                        class="border rounded p-4 text-center h-100"
                                    >

                                        <i
                                            class="fa fa-adjust fa-2x mb-2"
                                            title="Paiements partiels"
                                        />

                                        <div class="fs-2 fw-bold">

                                            <field
                                                name="partial_member_count"
                                            />

                                        </div>

                                        <div class="text-muted">

                                            Paiements partiels

                                        </div>

                                    </div>

                                </div>

                                <!-- NON PAYÉS -->

                                <div class="col-lg-4 col-md-6 mb-3">

                                    <div
                                        class="border rounded p-4 text-center h-100"
                                    >

                                        <i
                                            class="fa fa-exclamation-circle fa-2x mb-2"
                                            title="Membres non payés"
                                        />

                                        <div class="fs-2 fw-bold">

                                            <field
                                                name="unpaid_member_count"
                                            />

                                        </div>

                                        <div class="text-muted">

                                            Membres non payés

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </page>

                        <page
                            string="Historique des cycles"
                            name="subscription_history">

                            <field
                                name="period_ids"
                                nolabel="1"
                                readonly="1">

                                <list
                                    string="Historique des cycles"
                                    create="0"
                                    delete="0"
                                    default_order="id desc">

                                    <field
                                        name="name"
                                        string="Cycle"
                                    />

                                    <field
                                        name="collected_amount"
                                        widget="monetary"
                                        string="Cagnotte"
                                        sum="Total collecté"
                                    />

                                    <field
                                        name="allocated_amount"
                                        widget="monetary"
                                        string="Attribué"
                                        sum="Total attribué"
                                    />

                                    <field
                                        name="available_amount"
                                        widget="monetary"
                                        string="Disponible"
                                    />

                                    <field
                                        name="beneficiary_count"
                                        string="Bénéficiaires"
                                    />

                                    <field
                                        name="currency_id"
                                        column_invisible="1"
                                    />

                                </list>

                            </field>

                        </page>

                        <!-- ================================================= -->
                        <!-- NOTES                                             -->
                        <!-- ================================================= -->

                        <page
                            string="Notes internes"
                            name="subscription_notes"
                            >

                            <field
                                name="note"
                                placeholder="Ajouter une note interne..."
                            />

                        </page>

                    </notebook>

                </sheet>

                <!-- ================================================= -->
                <!-- CHATTER                                           -->
                <!-- ================================================= -->

                <chatter/>

            </form>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- VUE KANBAN                                                -->
    <!-- ========================================================= -->

    <record id="view_subscription_kanban" model="ir.ui.view">
        <field name="name">association.subscription.kanban</field>
        <field name="model">association.subscription</field>
        <field name="arch" type="xml">

            <kanban
                default_group_by="state"
                class="o_kanban_small_column">

                <field name="name"/>
                <field name="code"/>
                <field name="subscription_type"/>
                <field name="date"/>
                <field name="due_date"/>
                <field name="line_count"/>
                <field name="total_amount_due"/>
                <field name="total_amount_paid"/>
                <field name="total_balance"/>
                <field name="progress_percent"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="color"/>

                <templates>

                    <t t-name="card">

                        <div class="oe_kanban_global_click">

                            <div class="d-flex justify-content-between align-items-start mb-2">

                                <strong class="fs-5">

                                    <field name="name"/>

                                </strong>

                                <field
                                    name="state"
                                    widget="badge"/>

                            </div>


                            <div class="text-muted small mb-3">

                                <i class="fa fa-hashtag me-1"/>

                                <field name="code"/>

                            </div>


                            <div class="mb-2">

                                <field
                                    name="subscription_type"
                                    widget="badge"/>

                            </div>


                            <div class="small mb-1">

                                <i class="fa fa-users me-2"/>

                                <field name="line_count"/>

                                <span> membre(s)</span>

                            </div>


                            <div class="small mb-1">

                                <i class="fa fa-calendar me-2"/>

                                <field name="date"/>

                            </div>


                            <div class="small mb-3">

                                <i class="fa fa-calendar-check-o me-2"/>

                                <field name="due_date"/>

                            </div>


                            <div class="border-top pt-3">

                                <div class="d-flex justify-content-between">

                                    <span class="text-muted">
                                        Attendu
                                    </span>

                                    <strong>

                                        <field
                                            name="total_amount_due"
                                            widget="monetary"
                                            options="{'currency_field': 'currency_id'}"/>

                                    </strong>

                                </div>


                                <div class="d-flex justify-content-between">

                                    <span class="text-muted">
                                        Payé
                                    </span>

                                    <strong>

                                        <field
                                            name="total_amount_paid"
                                            widget="monetary"
                                            options="{'currency_field': 'currency_id'}"/>

                                    </strong>

                                </div>


                                <div class="mt-3">

                                    <field
                                        name="progress_percent"
                                        widget="progressbar"/>

                                </div>

                            </div>

                        </div>

                    </t>

                </templates>

            </kanban>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- ACTION                                                    -->
    <!-- ========================================================= -->

    <record id="action_subscription" model="ir.actions.act_window">

        <field name="name">Cotisations</field>

        <field name="res_model">association.subscription</field>

        <field name="view_mode">list,kanban,form</field>

        <field
            name="search_view_id"
            ref="view_subscription_search"/>

        <field
            name="context">
            {
                'search_default_filter_running': 0
            }
        </field>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Créez votre première cotisation
            </p>

            <p>
                Gérez les cotisations, les membres concernés,
                les montants attendus et le suivi du recouvrement.
            </p>

        </field>

    </record>

</odoo>