<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

<t
    t-name="primetech_reporting_center.FinanceKpis"
    owl="1">

    <div class="pt-finance-kpis">

        <div class="pt-finance-card">

            <span class="pt-label">
                Chiffre d'Affaires
            </span>

            <div class="pt-value">

                <t t-esc="
                    formatCurrency(
                        state.data.revenue?.value
                    )
                "/>

            </div>

            <div
                t-att-class="
                    state.data.revenue?.variation >= 0
                    ? 'pt-trend positive'
                    : 'pt-trend negative'
                ">

                <t t-esc="
                    state.data.revenue?.variation
                "/> %

            </div>

        </div>

        <div class="pt-finance-card">

            <span class="pt-label">
                Créances Clients
            </span>

            <div class="pt-value">

                <t t-esc="
                    formatCurrency(
                        state.data.receivables
                    )
                "/>

            </div>

        </div>

        <div class="pt-finance-card">

            <span class="pt-label">
                Dettes Fournisseurs
            </span>

            <div class="pt-value">

                <t t-esc="
                    formatCurrency(
                        state.data.payables
                    )
                "/>

            </div>

        </div>

        <div class="pt-finance-card">

            <span class="pt-label">
                Trésorerie
            </span>

            <div class="pt-value">

                <t t-esc="
                    formatCurrency(
                        state.data.cash
                    )
                "/>

            </div>

        </div>

    </div>

</t>

</templates>