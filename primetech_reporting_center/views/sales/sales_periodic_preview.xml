<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record
        id="view_sales_preview_wizard"
        model="ir.ui.view">

        <field name="name">
            sales.preview.wizard.form
        </field>

        <field name="model">
            primetech.sales.preview.wizard
        </field>

        <field name="arch" type="xml">

            <form
                string="Prévisualisation du rapport"
                create="0"
                edit="0">

                <header>

                    <button
                        name="action_print_pdf"
                        type="object"
                        string="Imprimer PDF"
                        class="btn-primary"
                        icon="fa-file-pdf-o"/>

                    <button
                        name="action_export_xlsx"
                        type="object"
                        string="Exporter Excel"
                        class="btn-success"
                        icon="fa-file-excel-o"/>

                    <button
                        name="action_back"
                        type="object"
                        string="Fermer"
                        class="btn-secondary"
                        icon="fa-times"/>

                </header>

                <sheet>

                    <field
                        name="name"
                        readonly="1"/>

                    <field
                        name="html"
                        widget="html"
                        readonly="1"
                        nolabel="1"/>

                </sheet>

            </form>

        </field>

    </record>

</odoo>