<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record
        id="view_trial_balance_wizard"
        model="ir.ui.view">

        <field name="name">primetech.trial.balance.wizard.form</field>

        <field name="model">primetech.trial.balance.wizard</field>

        <field name="arch" type="xml">

            <form
                string="Balance Générale"
                create="false"
                edit="false">

                <sheet>

                    <div class="oe_title">

                        <h1>

                            Balance Générale

                        </h1>

                        <div class="text-muted">

                            Paramètres de génération du rapport

                        </div>

                    </div>

                    <group>

                        <group string="Période d'analyse">

                            <field
                                name="date_from"
                                required="1"/>

                            <field
                                name="date_to"
                                required="1"/>

                        </group>

                        <group string="Options">

                            <field
                                name="level"/>

                            <field
                                name="posted_only"/>

                        </group>

                    </group>

                    <separator
                        string="Le rapport sera généré selon les critères sélectionnés"
                        colspan="4"/>

                </sheet>

                <footer>

                    <button
                        name="action_open_report"
                        string="Générer le rapport"
                        type="object"
                        class="btn btn-primary"/>
                    
                    <button
                        name="action_export_excel"
                        type="object"
                        string="Export XLSX"
                        class="btn-secondary"
                        icon="fa-file-excel-o"/>
                        

                    <button
                        string="Annuler"
                        special="cancel"
                        class="btn btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>