<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record
        id="view_general_ledger_wizard"
        model="ir.ui.view">

        <field name="name">primetech.general.ledger.wizard.form</field>

        <field name="model">primetech.general.ledger.wizard</field>

        <field name="arch" type="xml">

            <form string="Grand Livre OHADA">

                <sheet>

                    <group>

                        <group>

                            <field name="date_from"/>

                            <field name="date_to"/>

                        </group>

                        <group>

                            <field name="posted_only"/>

                            <field name="hide_zero_balance"/>

                        </group>

                    </group>

                    <group>

                        <group>

                            <field
                                name="account_from_id"
                                options="{'no_create': True}"/>

                        </group>

                        <group>

                            <field
                                name="account_to_id"
                                options="{'no_create': True}"/>

                        </group>

                    </group>

                </sheet>

                <footer>

                    <button
                        name="action_open_report"
                        type="object"
                        string="Prévisualiser"
                        class="btn-primary"
                        icon="fa-eye"/>

                    <button
                        name="action_export_excel"
                        type="object"
                        string="Export XLSX"
                        class="btn-secondary"
                        icon="fa-file-excel-o"/>

                    <button
                        string="Fermer"
                        special="cancel"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>