<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record
        id="view_accounting_journal_wizard"
        model="ir.ui.view">

        <field name="name">accounting.journal.wizard.form</field>

        <field name="model">primetech.accounting.journal.wizard</field>

        <field name="arch" type="xml">

            <form string="Journaux Comptables">

                <group>

                    <group>

                        <field name="date_from"/>

                        <field name="date_to"/>

                    </group>

                    <group>

                        <field
                            name="posted_only"/>

                    </group>

                </group>

                <group>

                    <field
                        name="journal_ids"
                        widget="many2many_tags"/>

                </group>

                <footer>

                    <button
                        name="action_open_report"
                        type="object"
                        string="Prévisualiser"
                        class="btn-primary"
                        icon="fa-eye"/>

                    <button
                        name="action_export_excel"
                        type="object"
                        string="Export XLSX"
                        class="btn-secondary"
                        icon="fa-file-excel-o"/>

                    <button
                        string="Annuler"
                        special="cancel"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>