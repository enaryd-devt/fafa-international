        <field name="category_id" ref="module_category_primetech_transfer"/>
    </record>
    <record id="rule_primetech_transfer_warehouseman_agency" model="ir.rule">
        <field name="name">Transfer: warehouseman authorized agencies</field>
        <field name="model_id" ref="model_primetech_inter_agency_transfer"/>
        <field name="domain_force">['|', '&amp;', ('source_agency_id', 'in', user.company_ids.ids), ('state', 'in', ['draft','confirmed','waiting_preparation','preparing','ready','shipped','in_transit','cancelled','returned']), '&amp;', ('destination_agency_id', 'in', user.company_ids.ids), ('state', 'in', ['in_transit','waiting_reception','partial_reception','discrepancy','received','done','returned'])]</field>
        <field name="groups" eval="[(4, ref('group_primetech_transfer_warehouseman'))]"/>
    </record>
