<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_primetech_transfer" model="ir.module.category">
        <field name="name">Transferts de stock PrimeTech</field>
        <field name="sequence">30</field>
    </record>
    <record id="group_primetech_transfer_warehouseman" model="res.groups">
        <field name="name">Magasinier</field>
        <field name="category_id" ref="module_category_primetech_transfer"/>
    </record>
    <record id="group_primetech_transfer_manager" model="res.groups">
        <field name="name">Gestionnaire de transferts</field>
